# Copy to .env and replace every study-specific value before a real run.
RUN_ID=real_seed001
TRUTH_FILE=truth.npz
CALIBRATION_FILE=calibration.json
# Set to 1 only for the dedicated calibration run, never evaluation.
CALIBRATION_MODE=0

# Independent streams: keep POWER_SEED fixed while sweeping communication.
POWER_SEED=1001
NETWORK_SEED=2001
NETWORK_RUN=1

# 0 derives the full 13,200 s horizon; use 24 for the two-event smoke test.
STOP_TIME=0

# REQUIRED predeclared oracle threshold for d(t)=||x_true-x_hat||_W.
# This is intentionally blank: it must not be invented from evaluation data.
DRIFT_GAMMA=
